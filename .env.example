DATABASE_URL="postgresql://sentinel:sentinel@postgres:5432/sentinel?schema=public"
SESSION_SECRET="replace-with-a-long-development-secret"
DEMO_TARGET_URL="http://demo-target:8080"
BROWSER_SELENIUM_URL="http://browser:4444/wd/hub"
BROWSER_VIEWER_URL="http://localhost:7900/?autoconnect=true&resize=scale&view_only=false"
RECORDER_ORIGIN="http://demo-target:8080"
MINIO_ENDPOINT="http://minio:9000"
# Browser-reachable endpoint used only when Sentinel signs a private evidence URL.
MINIO_PUBLIC_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY="replace-with-local-access-key"
MINIO_SECRET_KEY="replace-with-local-secret-key"
MINIO_BUCKET="sentinel-evidence"
MINIO_REGION="us-east-1"
REDIS_URL="redis://redis:6379"
# Docker-local Mailpit SMTP delivery for Phase 6. Do not place production SMTP
# credentials in this file; Sentinel sends only safe notification summaries.
SMTP_HOST="mailpit"
SMTP_PORT="1025"
EMAIL_FROM="Sentinel <noreply@sentinel.local>"
SENTINEL_APP_URL="http://localhost:3001"
# Phase 12 controlled local bootstrap. These values create the first local
# organization and Admin; do not treat them as production credentials.
BOOTSTRAP_ORGANIZATION_NAME="Sentinel Demo"
BOOTSTRAP_ADMIN_EMAIL="ava.tester@example.test"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-local-admin-password"
# Optional Phase 8 Jira Cloud connection. These values are server/worker-only;
# do not use NEXT_PUBLIC_ names and do not commit a real API token.
JIRA_CLOUD_URL="https://your-site.atlassian.net"
JIRA_SERVICE_EMAIL="sentinel-bot@example.test"
JIRA_API_TOKEN="replace-with-jira-cloud-api-token"
# Worker-only values: do not use NEXT_PUBLIC_ names or expose them through API responses.
AUTO_RUN_DEMO_EMAIL="qa.tester@example.test"
AUTO_RUN_DEMO_PASSWORD="replace-with-demo-crm-password"
# Sentinel-only value for reviewed Guided Run password steps; never expose it to the browser UI or API.
GUIDED_RUN_DEMO_PASSWORD="replace-with-demo-crm-password"
# Required base64-encoded 32-byte key for Phase 4 variable values. Generate locally;
# never commit your real key or reuse it outside development.
VARIABLE_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"
# Phase 10 diagnostic connection. This must be a distinct QA database role with
# only CONNECT, schema USAGE, and SELECT on the allowlisted fixture table.
# Docker Compose supplies its local value; do not point this at Sentinel's app DB.
QA_DATABASE_URL="postgresql://qa_diagnostic:replace-with-read-only-password@qa-postgres:5432/qa_fixture"
# Phase 11 controlled-pilot lifecycle: completed Run evidence and completed
# database diagnostics older than this many days are removed by the worker.
EVIDENCE_RETENTION_DAYS="30"
# Optional Phase 13 GitHub App and advisory source analysis. These values are
# server/worker-only. Use a disposable GitHub sandbox and never commit a real
# App private key, webhook secret, installation token, or OpenAI API key.
GITHUB_APP_ID="replace-with-github-app-id"
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET="replace-with-a-long-random-webhook-secret"
GITHUB_APP_SLUG="replace-with-github-app-slug"
SENTINEL_PUBLIC_WEBHOOK_URL="https://your-public-tunnel.example/api/internal/github/webhooks"
OPENAI_API_KEY="replace-with-server-only-openai-api-key"
OPENAI_MODEL="gpt-5-mini"
# Optional Phase 14 Telegram assistant. These values stay server/worker-only.
# The Telegram tunnel must point only to the restricted webhook gateway; do not
# expose the Sentinel UI. Generate a separate base64-encoded 32-byte key.
TELEGRAM_BOT_TOKEN="replace-with-telegram-bot-token"
TELEGRAM_BOT_USERNAME="replace-with-bot-username-without-at-sign"
TELEGRAM_WEBHOOK_SECRET="replace-with-a-long-random-webhook-secret"
TELEGRAM_WEBHOOK_URL="https://your-telegram-tunnel.example/api/internal/telegram/webhook"
MESSAGING_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"
