DATABASE_URL="postgresql://sentinel:sentinel@postgres:5432/sentinel?schema=public"
SESSION_SECRET="replace-with-a-long-development-secret"
DEMO_TARGET_URL="http://demo-target:8080"
BROWSER_SELENIUM_URL="http://browser:4444/wd/hub"
BROWSER_VIEWER_URL="http://localhost:7900/?autoconnect=true&resize=scale&view_only=false"
RECORDER_ORIGIN="http://demo-target:8080"
MINIO_ENDPOINT="http://minio:9000"
# Browser-reachable endpoint used only when Sentinel signs a private evidence URL.
MINIO_PUBLIC_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY="replace-with-local-access-key"
MINIO_SECRET_KEY="replace-with-local-secret-key"
MINIO_BUCKET="sentinel-evidence"
MINIO_REGION="us-east-1"
REDIS_URL="redis://redis:6379"
# Worker-only values: do not use NEXT_PUBLIC_ names or expose them through API responses.
AUTO_RUN_DEMO_EMAIL="qa.tester@example.test"
AUTO_RUN_DEMO_PASSWORD="replace-with-demo-crm-password"
# Sentinel-only value for reviewed Guided Run password steps; never expose it to the browser UI or API.
GUIDED_RUN_DEMO_PASSWORD="replace-with-demo-crm-password"
# Required base64-encoded 32-byte key for Phase 4 variable values. Generate locally;
# never commit your real key or reuse it outside development.
VARIABLE_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"
