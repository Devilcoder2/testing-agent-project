generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordingStatus {
  DRAFT
  ACTIVE
  SAVED
  DISCARDED
}

enum StepKind {
  NAVIGATION
  CLICK
  TEXT_ENTRY
}

enum RunStatus {
  QUEUED
  RUNNING
  PAUSED
  CANCELLING
  COMPLETED
}

enum RunMode {
  GUIDED
  AUTO
}

enum RunOutcome {
  PASSED
  FAILED
  INTERRUPTED
}

enum EvidenceStatus {
  COMPLETE
  PARTIAL
}

enum RunStepStatus {
  PENDING
  RUNNING
  WAITING_FOR_CONFIRMATION
  PASSED
  FAILED
}

enum RunAttemptStatus {
  QUEUED
  RUNNING
  COMPLETED
}

enum RunFailureReason {
  SELECTOR_NOT_FOUND
  SELECTOR_AMBIGUOUS
  ACTION_FAILED
  NAVIGATION_TIMEOUT
  BROWSER_STARTUP
  CHECKPOINT_TIMEOUT
  CANCELLED
  VARIABLE_UNSUPPORTED
  INFRASTRUCTURE_ERROR
}

enum EvidenceKind {
  SCREENSHOT
  NETWORK
  CONSOLE
  STORAGE
  CAPTURE_ERROR
  DATABASE
}

enum DatabaseDiagnosticKind {
  CUSTOMER_LOOKUP_BY_EMAIL
}

enum DatabaseDiagnosticStatus {
  COMPLETE
  INCOMPLETE
  UNAVAILABLE
}

enum MaintenanceKind {
  EVIDENCE_RETENTION
}

enum MaintenanceStatus {
  RUNNING
  COMPLETED
  PARTIAL
}

enum TestDataStatus {
  SAFE
  RESERVED
  CONSUMED
  INVALID
}

enum TestDataReusePolicy {
  REUSABLE
  SINGLE_USE
}

enum VariableSource {
  STATIC
  POOL
  MANUAL
}

enum ReleaseRunStatus {
  QUEUED
  RUNNING
  COMPLETED
}

enum ReleaseReadiness {
  IN_PROGRESS
  READY
  NOT_READY
}

enum ReleaseRunItemStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  INTERRUPTED
  EXCLUDED
}

enum ReleaseRunItemReason {
  CHECKPOINT_REQUIRES_INDIVIDUAL_RUN
  VARIABLE_REQUIRES_STATIC_DEFAULT
  AUTO_RUN_QUEUE_FAILED
}

enum NotificationType {
  RUN_FAILED
  AUTO_RUN_CHECKPOINT
  RELEASE_RUN_COMPLETED
  CHANGE_PROPOSAL_REQUESTED
  CHANGE_PROPOSAL_RESOLVED
}

enum ChangeProposalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  STALE
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum TestSuggestionKind {
  REQUIRED_MISSING
  INVALID_EMAIL
  BOUNDARY_TOO_SHORT
  BOUNDARY_TOO_LONG
}

enum TestSuggestionStatus {
  DRAFT
  APPROVED
  DISMISSED
}

enum JiraFilingStatus {
  DRAFT
  QUEUED
  FILED
  FAILED
}

enum JiraFilingAction {
  CREATE
  COMMENT
}

enum OrganizationRole {
  ADMIN
  MANAGER
  TESTER
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum AuthTokenKind {
  INVITE
  PASSWORD_RESET
}

model User {
  id                   String              @id @default(cuid())
  email                String              @unique
  displayName          String
  passwordHash         String?
  accountStatus        AccountStatus       @default(ACTIVE)
  organizationMemberships OrganizationMember[]
  sessions             UserSession[]
  authTokens           AuthToken[]
  memberships          ProductMembership[]
  products             Product[]
  recordings           RecordingSession[]  @relation("RecordingOwner")
  testCases            TestCase[]          @relation("TestCaseOwner")
  runs                 Run[]               @relation("RunInitiator")
  ownedReleases        Release[]           @relation("ReleaseOwner")
  releaseRuns          ReleaseRun[]        @relation("ReleaseRunInitiator")
  notifications        Notification[]      @relation("NotificationRecipient")
  approvedSuggestions  TestSuggestion[]    @relation("SuggestionApprover")
  dismissedSuggestions TestSuggestion[]    @relation("SuggestionDismisser")
  jiraFilings          JiraFiling[]        @relation("JiraFilingRequester")
  proposedChanges      ChangeProposal[]    @relation("ChangeProposalCreator")
  approvalRequests     ChangeProposal[]    @relation("ChangeProposalOwner")
  databaseDiagnostics  DatabaseDiagnostic[] @relation("DatabaseDiagnosticRequester")
  auditEvents          AuditEvent[]        @relation("AuditActor")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model Product {
  id              String              @id @default(cuid())
  organizationId  String?
  name            String
  createdById     String
  createdBy       User                @relation(fields: [createdById], references: [id])
  organization    Organization?       @relation(fields: [organizationId], references: [id])
  memberships     ProductMembership[]
  recordings      RecordingSession[]
  testCases       TestCase[]
  featureLabels   FeatureLabel[]
  runs            Run[]
  releaseRunItems ReleaseRunItem[]
  testDataSets    TestDataSet[]
  notifications   Notification[]
  suggestions     TestSuggestion[]
  jiraConfig      JiraProjectConfig?
  jiraIssues      JiraIssue[]
  jiraFilings     JiraFiling[]
  changeProposals ChangeProposal[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([createdById, name])
  @@index([organizationId, name])
}

model Organization {
  id          String               @id @default(cuid())
  name        String               @unique
  memberships OrganizationMember[]
  products    Product[]
  authTokens  AuthToken[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model OrganizationMember {
  organizationId String
  userId         String
  role           OrganizationRole
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@id([organizationId, userId])
  @@index([userId, role])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model AuthToken {
  id             String        @id @default(cuid())
  userId         String
  organizationId String?
  kind           AuthTokenKind
  tokenHash      String        @unique
  expiresAt      DateTime
  usedAt         DateTime?
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([userId, kind, expiresAt])
}

model ProductMembership {
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

model RecordingSession {
  id        String              @id @default(cuid())
  productId String
  ownerId   String
  testName  String
  targetUrl String
  tokenHash String              @unique
  status    RecordingStatus     @default(DRAFT)
  product   Product             @relation(fields: [productId], references: [id])
  owner     User                @relation("RecordingOwner", fields: [ownerId], references: [id])
  steps     RecordedStep[]
  variables RecordingVariable[]
  testCase  TestCase?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model RecordedStep {
  id                 String           @id @default(cuid())
  recordingSessionId String
  order              Int
  kind               StepKind
  timestamp          DateTime
  target             Json
  value              String?
  isRedacted         Boolean          @default(false)
  description        String?
  expectedOutcome    String?
  variableName       String?
  isCheckpoint       Boolean          @default(false)
  recordingSession   RecordingSession @relation(fields: [recordingSessionId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([recordingSessionId, order])
}

model RecordingVariable {
  id                 String           @id @default(cuid())
  recordingSessionId String
  name               String
  encryptedValue     String?
  recordingSession   RecordingSession @relation(fields: [recordingSessionId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([recordingSessionId, name])
}

model TestCase {
  id                  String                 @id @default(cuid())
  productId           String
  ownerId             String
  recordingSessionId  String                 @unique
  name                String
  currentVersion      Int                    @default(1)
  product             Product                @relation(fields: [productId], references: [id])
  owner               User                   @relation("TestCaseOwner", fields: [ownerId], references: [id])
  recordingSession    RecordingSession       @relation(fields: [recordingSessionId], references: [id])
  versions            TestCaseVersion[]
  runs                Run[]
  featureLabels       TestCaseFeatureLabel[]
  releaseTests        ReleaseTest[]
  releaseRunItems     ReleaseRunItem[]
  sourceSuggestions   TestSuggestion[]       @relation("SuggestionSourceTestCase")
  approvedSuggestions TestSuggestion[]       @relation("SuggestionApprovedTestCase")
  jiraIssues          JiraIssue[]
  changeProposals     ChangeProposal[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
}

model TestCaseVersion {
  id              String           @id @default(cuid())
  testCaseId      String
  version         Int
  testCase        TestCase         @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  steps           TestStep[]
  variables       TestVariable[]
  runs            Run[]
  releaseRunItems ReleaseRunItem[]
  suggestions     TestSuggestion[]
  changeProposals ChangeProposal[]
  createdAt       DateTime         @default(now())

  @@unique([testCaseId, version])
}

model TestStep {
  id                String           @id @default(cuid())
  testCaseVersionId String
  order             Int
  kind              StepKind
  timestamp         DateTime
  target            Json
  value             String?
  isRedacted        Boolean          @default(false)
  description       String?
  expectedOutcome   String?
  variableName      String?
  isCheckpoint      Boolean          @default(false)
  testCaseVersion   TestCaseVersion  @relation(fields: [testCaseVersionId], references: [id], onDelete: Cascade)
  runStepResults    RunStepResult[]
  suggestions       TestSuggestion[]
  proposalChanges   ChangeProposalStep[]

  @@unique([testCaseVersionId, order])
}

model TestVariable {
  id                   String          @id @default(cuid())
  testCaseVersionId    String
  name                 String
  staticValueEncrypted String?
  testCaseVersion      TestCaseVersion @relation(fields: [testCaseVersionId], references: [id], onDelete: Cascade)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@unique([testCaseVersionId, name])
}

model TestSuggestion {
  id                 String               @id @default(cuid())
  productId          String
  sourceTestCaseId   String
  sourceVersionId    String
  sourceStepId       String
  kind               TestSuggestionKind
  status             TestSuggestionStatus @default(DRAFT)
  title              String
  rationale          String
  expectedOutcome    String
  proposedValue      String
  approvedTestCaseId String?              @unique
  approvedById       String?
  approvedAt         DateTime?
  dismissedById      String?
  dismissedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  product            Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceTestCase     TestCase             @relation("SuggestionSourceTestCase", fields: [sourceTestCaseId], references: [id], onDelete: Cascade)
  sourceVersion      TestCaseVersion      @relation(fields: [sourceVersionId], references: [id], onDelete: Cascade)
  sourceStep         TestStep             @relation(fields: [sourceStepId], references: [id], onDelete: Cascade)
  approvedTestCase   TestCase?            @relation("SuggestionApprovedTestCase", fields: [approvedTestCaseId], references: [id])
  approvedBy         User?                @relation("SuggestionApprover", fields: [approvedById], references: [id])
  dismissedBy        User?                @relation("SuggestionDismisser", fields: [dismissedById], references: [id])

  @@unique([sourceVersionId, sourceStepId, kind])
  @@index([productId, status, createdAt])
  @@index([sourceTestCaseId, createdAt])
}

model FeatureLabel {
  id        String                 @id @default(cuid())
  productId String
  name      String
  product   Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  testCases TestCaseFeatureLabel[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@unique([productId, name])
  @@index([productId, name])
}

model TestCaseFeatureLabel {
  testCaseId     String
  featureLabelId String
  testCase       TestCase     @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  featureLabel   FeatureLabel @relation(fields: [featureLabelId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([testCaseId, featureLabelId])
  @@index([featureLabelId])
}

model Release {
  id        String        @id @default(cuid())
  name      String
  ownerId   String
  owner     User          @relation("ReleaseOwner", fields: [ownerId], references: [id])
  tests     ReleaseTest[]
  runs      ReleaseRun[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([ownerId, updatedAt])
}

model ReleaseTest {
  releaseId  String
  testCaseId String
  release    Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([releaseId, testCaseId])
  @@index([testCaseId])
}

model ReleaseRun {
  id            String           @id @default(cuid())
  releaseId     String
  initiatedById String
  status        ReleaseRunStatus @default(QUEUED)
  readiness     ReleaseReadiness @default(IN_PROGRESS)
  startedAt     DateTime         @default(now())
  completedAt   DateTime?
  release       Release          @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  initiatedBy   User             @relation("ReleaseRunInitiator", fields: [initiatedById], references: [id])
  items         ReleaseRunItem[]
  notifications Notification[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([releaseId, createdAt])
}

model ReleaseRunItem {
  id                String                @id @default(cuid())
  releaseRunId      String
  testCaseId        String
  testCaseVersionId String
  productId         String
  runId             String?               @unique
  status            ReleaseRunItemStatus  @default(QUEUED)
  exclusionReason   ReleaseRunItemReason?
  releaseRun        ReleaseRun            @relation(fields: [releaseRunId], references: [id], onDelete: Cascade)
  testCase          TestCase              @relation(fields: [testCaseId], references: [id])
  testCaseVersion   TestCaseVersion       @relation(fields: [testCaseVersionId], references: [id])
  product           Product               @relation(fields: [productId], references: [id])
  run               Run?                  @relation("ReleaseRunItemRun", fields: [runId], references: [id])
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([releaseRunId, testCaseId])
  @@index([releaseRunId, status])
}

model TestDataSet {
  id              String               @id @default(cuid())
  productId       String
  name            String
  fieldNames      String[]
  encryptedFields String
  status          TestDataStatus       @default(SAFE)
  reusePolicy     TestDataReusePolicy  @default(REUSABLE)
  reservedByRunId String?
  product         Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  reservedByRun   Run?                 @relation("ReservedDataSet", fields: [reservedByRunId], references: [id], onDelete: SetNull)
  bindings        RunVariableBinding[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([productId, name])
  @@index([productId, status])
  @@index([reservedByRunId])
}

model Run {
  id                 String               @id @default(cuid())
  testCaseId         String
  testCaseVersionId  String
  productId          String
  initiatedById      String
  targetUrl          String
  mode               RunMode              @default(GUIDED)
  status             RunStatus            @default(QUEUED)
  outcome            RunOutcome?
  evidenceStatus     EvidenceStatus       @default(COMPLETE)
  activeStepOrder    Int?
  failureReason      RunFailureReason?
  queuedAt           DateTime             @default(now())
  startedAt          DateTime?
  pausedAt           DateTime?
  cancellingAt       DateTime?
  checkpointDeadline DateTime?
  completedAt        DateTime?
  activeDurationMs   Int?
  benchmarkMedianMs  Int?
  durationDeltaMs    Int?
  testCase           TestCase             @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  testCaseVersion    TestCaseVersion      @relation(fields: [testCaseVersionId], references: [id], onDelete: Cascade)
  product            Product              @relation(fields: [productId], references: [id])
  initiatedBy        User                 @relation("RunInitiator", fields: [initiatedById], references: [id])
  stepResults        RunStepResult[]
  attempts           RunAttempt[]
  evidence           EvidenceItem[]
  variableBindings   RunVariableBinding[]
  reservedDataSets   TestDataSet[]        @relation("ReservedDataSet")
  releaseRunItem     ReleaseRunItem?      @relation("ReleaseRunItemRun")
  notifications      Notification[]
  jiraFiling         JiraFiling?
  changeProposal     ChangeProposal?
  databaseDiagnostics DatabaseDiagnostic[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([productId, createdAt])
  @@index([testCaseId, createdAt])
  @@index([mode, status, createdAt])
}

model DatabaseDiagnostic {
  id           String                   @id @default(cuid())
  runId        String
  kind         DatabaseDiagnosticKind
  status       DatabaseDiagnosticStatus
  requestedById String
  safeMetadata Json?
  errorCode    String?
  completedAt  DateTime?
  run          Run                      @relation(fields: [runId], references: [id], onDelete: Cascade)
  requestedBy  User                     @relation("DatabaseDiagnosticRequester", fields: [requestedById], references: [id])
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([runId, kind])
  @@index([runId, createdAt])
  @@index([requestedById, createdAt])
}

model MaintenanceRun {
  id                       String            @id @default(cuid())
  kind                     MaintenanceKind
  status                   MaintenanceStatus @default(RUNNING)
  deletedEvidenceCount     Int               @default(0)
  deletedScreenshotCount   Int               @default(0)
  deletedDiagnosticCount   Int               @default(0)
  errorCode                String?
  startedAt                DateTime          @default(now())
  completedAt              DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([kind, completedAt])
}

model Notification {
  id               String                     @id @default(cuid())
  recipientId      String
  productId        String?
  runId            String?
  releaseRunId     String?
  type             NotificationType
  deliveryStatus   NotificationDeliveryStatus @default(PENDING)
  deliveryAttempts Int                        @default(0)
  deliveryError    String?
  sentAt           DateTime?
  readAt           DateTime?
  recipient        User                       @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  product          Product?                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  run              Run?                       @relation(fields: [runId], references: [id], onDelete: Cascade)
  releaseRun       ReleaseRun?                @relation(fields: [releaseRunId], references: [id], onDelete: Cascade)
  changeProposalId String?
  changeProposal   ChangeProposal?            @relation(fields: [changeProposalId], references: [id], onDelete: Cascade)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@unique([recipientId, runId, type])
  @@unique([recipientId, releaseRunId, type])
  @@unique([recipientId, changeProposalId, type])
  @@index([recipientId, readAt, createdAt])
  @@index([runId, type])
  @@index([releaseRunId, type])
  @@index([productId, createdAt])
}

model ChangeProposal {
  id              String               @id @default(cuid())
  runId           String               @unique
  productId       String
  testCaseId      String
  sourceVersionId String
  createdById     String
  ownerId         String
  status          ChangeProposalStatus @default(DRAFT)
  context         String
  decisionNote    String?
  submittedAt     DateTime?
  decidedAt       DateTime?
  appliedVersion  Int?
  product         Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  testCase        TestCase             @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  sourceVersion   TestCaseVersion      @relation(fields: [sourceVersionId], references: [id], onDelete: Cascade)
  run             Run                  @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdBy       User                 @relation("ChangeProposalCreator", fields: [createdById], references: [id])
  owner           User                 @relation("ChangeProposalOwner", fields: [ownerId], references: [id])
  changes         ChangeProposalStep[]
  notifications   Notification[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([ownerId, status, createdAt])
  @@index([productId, status, createdAt])
}

model ChangeProposalStep {
  id                    String         @id @default(cuid())
  changeProposalId      String
  sourceStepId          String
  order                 Int
  proposedDescription   String?
  proposedExpectedOutcome String?
  proposal              ChangeProposal @relation(fields: [changeProposalId], references: [id], onDelete: Cascade)
  sourceStep            TestStep       @relation(fields: [sourceStepId], references: [id], onDelete: Cascade)

  @@unique([changeProposalId, sourceStepId])
  @@index([sourceStepId])
}

model RunVariableBinding {
  id             String         @id @default(cuid())
  runId          String
  testVariableId String?
  name           String
  source         VariableSource
  valueEncrypted String
  dataSetId      String?
  run            Run            @relation(fields: [runId], references: [id], onDelete: Cascade)
  dataSet        TestDataSet?   @relation(fields: [dataSetId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())

  @@unique([runId, name])
  @@index([dataSetId])
}

model RunAttempt {
  id               String            @id @default(cuid())
  runId            String
  attemptNumber    Int
  status           RunAttemptStatus  @default(QUEUED)
  failureReason    RunFailureReason?
  jobId            String?           @unique
  startedAt        DateTime?
  completedAt      DateTime?
  activeDurationMs Int?
  run              Run               @relation(fields: [runId], references: [id], onDelete: Cascade)
  evidence         EvidenceItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([runId, attemptNumber])
  @@index([runId, createdAt])
}

model RunStepResult {
  id          String         @id @default(cuid())
  runId       String
  testStepId  String
  order       Int
  status      RunStepStatus  @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  run         Run            @relation(fields: [runId], references: [id], onDelete: Cascade)
  testStep    TestStep       @relation(fields: [testStepId], references: [id], onDelete: Cascade)
  evidence    EvidenceItem[]

  @@unique([runId, order])
  @@unique([runId, testStepId])
}

model EvidenceItem {
  id              String         @id @default(cuid())
  runId           String
  runStepResultId String?
  runAttemptId    String?
  kind            EvidenceKind
  objectKey       String?        @unique
  checksum        String?
  contentType     String?
  byteSize        Int?
  metadata        Json?
  captureError    String?
  capturedAt      DateTime       @default(now())
  run             Run            @relation(fields: [runId], references: [id], onDelete: Cascade)
  runStepResult   RunStepResult? @relation(fields: [runStepResultId], references: [id], onDelete: Cascade)
  runAttempt      RunAttempt?    @relation(fields: [runAttemptId], references: [id], onDelete: Cascade)

  @@index([runId, capturedAt])
  @@index([runStepResultId])
  @@index([runAttemptId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  details    Json?
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  createdAt  DateTime @default(now())
}

model JiraProjectConfig {
  id          String   @id @default(cuid())
  productId   String   @unique
  projectKey  String
  validatedAt DateTime?
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model JiraIssue {
  id             String       @id @default(cuid())
  productId      String
  testCaseId     String
  jiraKey        String       @unique
  jiraUrl        String
  isOpen         Boolean      @default(true)
  statusCategory String?
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  testCase       TestCase     @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  filings        JiraFiling[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([testCaseId, isOpen])
  @@index([productId, isOpen])
}

model JiraFiling {
  id            String           @id @default(cuid())
  runId         String           @unique
  productId     String
  requestedById String
  jiraIssueId   String?
  status        JiraFilingStatus @default(DRAFT)
  action        JiraFilingAction?
  summary       String
  description   String
  priority      String           @default("Medium")
  attemptCount  Int              @default(0)
  deliveryError String?
  queuedAt      DateTime?
  filedAt       DateTime?
  run           Run              @relation(fields: [runId], references: [id], onDelete: Cascade)
  product       Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  requestedBy   User             @relation("JiraFilingRequester", fields: [requestedById], references: [id])
  jiraIssue     JiraIssue?       @relation(fields: [jiraIssueId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([productId, createdAt])
  @@index([jiraIssueId, createdAt])
}
